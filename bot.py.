import time
import requests
from googletrans import Translator

# Initialize translator for global reach
translator = Translator()

# Brand Configuration
BRAND_NAME = "YourBrandName"
WEBSITE_LINK = "https://yourbrandwebsite.com"

# List of global target languages to translate your marketing pitch into
TARGET_LANGUAGES = ['es', 'fr', 'de', 'ja', 'ar', 'zh-cn'] 

def localize_message(base_text):
    """Translates your base marketing text into multiple languages instantly."""
    localized_posts = {}
    for lang in TARGET_LANGUAGES:
        try:
            translated = translator.translate(base_text, dest=lang)
            localized_posts[lang] = translated.text
        except Exception as e:
            localized_posts[lang] = base_text
    return localized_posts

def run_global_campaign():
    """Main execution loop that localizes and pushes your marketing content."""
    base_promo = f"Discover the ultimate experience with {BRAND_NAME}! Elevate your lifestyle today."
    
    print("🌍 Generating global translations...")
    translated_campaigns = localize_message(base_promo)
    
    for lang, content in translated_campaigns.items():
        final_post = f"{content}\n\nCheck us out: {WEBSITE_LINK} [{lang.upper()}]"
        print(f"[BROADCASTED - {lang.upper()}]: {final_post}\n")

if __name__ == "__main__":
    print(f"🚀 {BRAND_NAME} Global Marketing Bot is live...")
    run_global_campaign()
